<persistence xmlns="http://java.sun.com/xml/ns/persistence"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence
             http://xmlns.jcp.org/xml/ns/persistence/persistence_2_0.xsd"
             version="2.0">
	<persistence-unit name="csr-db">
		<non-jta-data-source>java:comp/env/jdbc/csrDataSource</non-jta-data-source>
		<class>com.kroger.pharmacy.csr.domain.PartialRxExtract</class>
		<class>com.kroger.pharmacy.csr.domain.PartialFacility</class>
		<class>com.kroger.pharmacy.csr.domain.RxExtract</class>
		<class>com.kroger.pharmacy.csr.domain.Report</class>
		<class>com.kroger.pharmacy.csr.domain.Contact</class>
		<class>com.kroger.pharmacy.csr.domain.CsrState</class>
		<class>com.kroger.pharmacy.csr.domain.FacilityId</class>
		<class>com.kroger.pharmacy.csr.domain.PartialState</class>
		<class>com.kroger.pharmacy.csr.domain.StateReportingDetail</class>
		<class>com.kroger.pharmacy.csr.domain.StateReportingEmailType</class>
		<class>com.kroger.pharmacy.csr.domain.StateReportingMethod</class>
		<class>com.kroger.pharmacy.csr.domain.StateReportingSchedule</class>
		<class>com.kroger.pharmacy.csr.domain.State</class>
	</persistence-unit>
</persistence>
