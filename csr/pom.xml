			<artifactId>kroger-ldap</artifactId>
			<!-- <version>${kroger.ldap.version}</version> -->
		</dependency>
		<dependency>
			<groupId>com.kroger.commons</groupId>
			<artifactId>kroger-logging</artifactId>
			<!-- <version>${kroger.logging.version}</version> -->
		</dependency>
		<dependency>
			<groupId>com.kroger.commons</groupId>
			<artifactId>kroger-calendar</artifactId>
			<!-- <version>${kroger-calendar.version}</version> -->
		</dependency>
		<dependency>
			<groupId>com.kroger.commons</groupId>
			<artifactId>kroger-json-pom</artifactId>
			<!-- <version>${kroger.json.pom.version}</version> -->
			<type>pom</type>
		</dependency>
		<!-- Testing Dependencies -->
		<dependency>
			<groupId>com.kroger.commons</groupId>
			<artifactId>kroger-test-pom</artifactId>
			<!-- <version>${kroger.test.pom.version}</version> -->
			<type>pom</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.openqa.selenium.server</groupId>
			<artifactId>selenium-server-coreless</artifactId>
			<version>0.9.0</version>
			<scope>test</scope>
		</dependency>
		<!-- Excluded Dependencies; provided by app server -->
		<dependency>
			<groupId>javax.servlet</groupId>
			<artifactId>servlet-api</artifactId>
			<!-- <version>2.5</version> -->
			<scope>provided</scope>
		</dependency>
		<!-- Logging Dependency -->
		<!-- <dependency>
			<groupId>com.kroger.commons</groupId>
			<artifactId>kroger-logging</artifactId>
		</dependency> -->
		<dependency>
			<groupId>com.kroger.eprn.modules</groupId>
			<artifactId>eprn-datawarehouse-rmi</artifactId>
		</dependency>
		<!-- Commons Logging Work-Around for WebSphere (websphere.profile) -->
		<dependency>
			<groupId>commons-logging</groupId>
			<artifactId>commons-logging</artifactId>
			<scope>${commons.logging.scope.selector}</scope>
		</dependency>
