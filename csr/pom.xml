<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.kroger.pharmacy</groupId>
	<artifactId>csr</artifactId>
	<packaging>war</packaging>
	<version>2.3.1-SNAPSHOT</version>
	<name>csr</name>
	<url>http://confluence.kroger.com/</url>
	<description>csr</description>
	<!-- ================================================ -->
	<parent>
		<groupId>com.kroger.commons</groupId>
		<artifactId>kroger-project-pom</artifactId>
		<version>2.5.4</version>
	</parent>

	<properties>
	    <java.version>1.8</java.version>
	</properties>

	<!-- ================================================ -->
	<issueManagement>
		<system>jira</system>
		<url>http://ssjira.kroger.com/jira</url>
	</issueManagement>
	<ciManagement>
		<system>TeamCity</system>
		<url>http://teamcity.kroger.com/</url>
	</ciManagement>
	<!-- ================================================ -->
	<scm>
		<connection>
			scm:svn|ext|svn.kroger.com|/repos/eprn/trunk/Data%20Warehouse/EAF/csr</connection>
		<developerConnection>
			scm:svn|ext|svn.kroger.com|/repos/eprn/trunk/Data%20Warehouse/EAF/csr</developerConnection>
	</scm>
	<!-- ================================================ -->
	<developers>
		<developer>
			<name>Java Developer</name>
			<email>java.developer@kroger.com</email>
			<roles>
				<role>Developer</role>
			</roles>
			<organization>Kroger</organization>
		</developer>
	</developers>
	<!-- ================================================ -->
	<dependencies>
		<!-- Kroger Commons Dependencies -->
		<!-- OpenJPA Dependency (provided by container)-->
		<dependency>
			<groupId>com.kroger.commons</groupId>
			<artifactId>kroger-jpa${jpa.api.version}-pom</artifactId>
			<version>${kroger.jpa.pom.version}</version>
			<type>pom</type>
		</dependency>
		<!--  <dependency>
			<groupId>com.kroger.commons</groupId>
			<artifactId>kroger-openjpa-pom</artifactId>
			<type>pom</type>
			<scope>provided</scope>
		</dependency> -->
		<dependency>
			<groupId>com.kroger.commons</groupId>
			<artifactId>kroger-spring-pom</artifactId>
			<!-- <version>${kroger.spring.pom.version}</version> -->
			<type>pom</type>
		</dependency>
		<dependency>
			<groupId>com.kroger.commons</groupId>
			<artifactId>kroger-aop-pom</artifactId>
			<!-- <version>${kroger.aop.pom.version}</version> -->
			<type>pom</type>
		</dependency>
		<dependency>
			<groupId>com.kroger.commons</groupId>
			<artifactId>kroger-stripes-pom</artifactId>
			<!-- <version>${kroger.stripes.pom.version}</version> -->
			<type>pom</type>
			<exclusions>
				<exclusion>
					<groupId>taglibs</groupId>
					<artifactId>standard</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.apache.taglibs</groupId>
			<artifactId>taglibs-standard-impl</artifactId>
			<version>1.2.5</version>
		</dependency>
		<dependency>
			<groupId>com.kroger.commons</groupId>
			<artifactId>kroger-web</artifactId>
		</dependency>
		<dependency>
			<groupId>com.kroger.commons</groupId>
			<artifactId>kroger-core</artifactId>
			<!-- <version>${kroger.core.version}</version> -->
		</dependency>
		<dependency>
			<groupId>com.kroger.commons</groupId>
			<artifactId>kroger-util</artifactId>
			<!-- <version>${kroger.util.version}</version> -->
		</dependency>
